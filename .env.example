# ─── General ────────────────────────────────────────────────────────────────
TZ=America/Chicago
# Must match the directory name if you want backup.sh to auto-detect volumes.
# Change this if you clone the repo into a differently named folder.
COMPOSE_PROJECT_NAME=meetstack

# ─── Ports (host-side; change if you have conflicts) ────────────────────────
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# ─── n8n ────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
# Public URL n8n uses when building webhook URLs (set to your LAN IP or domain)
N8N_WEBHOOK_URL=http://localhost:5678

# ─── Ollama ─────────────────────────────────────────────────────────────────
# Ollama does not auto-pull models on startup. After the stack is running, pull
# a model manually: docker exec -it ollama ollama pull llama3

# ─── Vikunja database ───────────────────────────────────────────────────────
VIKUNJA_DB_ROOT_PASSWORD=changeme_root
VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_USER=vikunja
VIKUNJA_DB_PASSWORD=changeme_vikunja
# Random string used to sign JWT tokens — generate with: openssl rand -hex 32
VIKUNJA_JWT_SECRET=changeme_jwt_secret
# Frontend URL used in e-mail links (set to your LAN IP or domain)
VIKUNJA_FRONTEND_URL=http://localhost:3456
