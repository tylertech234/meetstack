# ─── General ────────────────────────────────────────────────────────────────
TZ=America/Chicago

# ─── Ports (host-side; change if you have conflicts) ────────────────────────
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81

# ─── SMTP (used by n8n email nodes and Vikunja notifications) ───────────────
# Gmail users: enable 2FA and create an App Password at
# https://myaccount.google.com/apppasswords — do NOT use your regular password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme@gmail.com
SMTP_PASSWORD=changeme_app_password
SMTP_FROM_ADDRESS=changeme@gmail.com

# ─── n8n ────────────────────────────────────────────────────────────────────
# Public URL n8n uses when building webhook URLs (set to your LAN IP or domain)
N8N_WEBHOOK_URL=http://localhost:5678

# ─── Open WebUI ─────────────────────────────────────────────────────────────
# Secret key for session tokens (prevents logout on container recreation)
WEBUI_SECRET_KEY=changeme_webui_secret

# ─── Ollama ─────────────────────────────────────────────────────────────────
# Default model to pull. Pick based on your hardware:
#   phi3:mini   — 3.8B params, best quality/size for 8 GB SBC (default)
#   tinyllama   — 1.1B params, fastest, lowest quality
#   gemma:2b    — 2B params, good middle ground
#   qwen2:1.5b  — 1.5B params, strong multilingual
#   llama3      — 8B params, best quality, needs 16 GB+ RAM
OLLAMA_MODEL=phi3:mini

# Agent model — used by setup-agent.sh for the AI agent workflows.
# Pick based on your GPU VRAM:
#   llama3.2:3b  — 2GB, fits 4GB VRAM (GTX 1650, SBC)
#   llama3.1:8b  — 4.7GB, fits 12GB+ VRAM (RTX 3060/4070, Tesla P100)
#   llama3.1:13b — 7.4GB Q4, fits 16GB+ VRAM (P100, RTX 4090)
# Leave blank for auto-detection.
OLLAMA_AGENT_MODEL=

# ─── Whisper (speech-to-text) ───────────────────────────────────────────────
# Model size — pick based on your hardware:
#   tiny   — 39 M params, ~1 GB RAM, fastest (SBC default)
#   base   — 74 M params, ~1 GB RAM, good for laptop
#   small  — 244 M params, ~2 GB RAM, needs GPU for speed
#   medium — 769 M params, ~5 GB RAM, desktop with GPU only
WHISPER_MODEL=tiny

# ─── Vikunja database ───────────────────────────────────────────────────────
VIKUNJA_DB_ROOT_PASSWORD=changeme_root
VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_USER=vikunja
VIKUNJA_DB_PASSWORD=changeme_vikunja
# Random string used to sign JWT tokens — generate with: openssl rand -hex 32
VIKUNJA_JWT_SECRET=changeme_jwt_secret
# Frontend URL used in e-mail links (set to your LAN IP or domain)
VIKUNJA_FRONTEND_URL=http://localhost:3456

# ─── Wiki.js database ───────────────────────────────────────────────────────
WIKIJS_DB_NAME=wikijs
WIKIJS_DB_USER=wikijs
WIKIJS_DB_PASSWORD=changeme_wikijs
